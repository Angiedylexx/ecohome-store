# Copia este archivo como ".env" y completa con tus credenciales reales.

# --- PostgreSQL ---
DB_HOST=localhost
DB_USER=postgres
DB_PASS=postgres
DB_NAME=ecohome_store
DB_PORT=5432

# --- Servidor (REST + Socket.IO comparten puerto) ---
# Los clientes (web-react y mobile-flutter) apuntan a 4500 por defecto.
PORT=4500

# Clave secreta para firmar y verificar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

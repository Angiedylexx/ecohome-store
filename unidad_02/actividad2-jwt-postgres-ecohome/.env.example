# Copia este archivo como ".env" y completa con tus valores reales.
# NUNCA subas el archivo .env real a git (ya está en .gitignore).

PORT=4001

# ---- Opción A: PostgreSQL en la nube (Neon, Supabase, Railway, etc.) ----
# Si usas un proveedor en la nube, descomenta y pega la cadena de conexión
# que te entregan (empieza con postgres:// o postgresql://). Cuando
# DATABASE_URL está presente, las variables DB_* de abajo se ignoran.
# DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# ---- Opción B: PostgreSQL instalado localmente ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=ecohome_chat

# Clave secreta para firmar y verificar los JWT
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=2h
